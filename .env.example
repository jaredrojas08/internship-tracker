# Copy to .env and fill in. .env is gitignored — never commit it.

# Local dev: absolute path to the service account JSON key.
# In GitHub Actions this same var holds the raw JSON string instead;
# the script detects which form it is.
GOOGLE_SHEETS_CREDENTIALS=/Users/YOUR_USERNAME/Desktop/internship-tracker-secrets/service-account.json

# The long string in the Sheet URL between /d/ and /edit
GOOGLE_SHEET_ID=
